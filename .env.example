###############################################################################
# Lenskart Retail Intelligence — Environment Configuration
#
# Copy this file:  cp .env.example .env
# Then edit .env with your actual values before running deploy.sh start
###############################################################################

# ── PostgreSQL (metadata DB for MLflow, Dagster, Feast) ─────────────────────
POSTGRES_USER=lenskart
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=lenskart_retail

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_here

# ── DuckDB (application database — path inside container) ────────────────────
LENSKART_DB_PATH=/app/data/dev.duckdb

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Dagster ──────────────────────────────────────────────────────────────────
DAGSTER_HOME=/app/dagster_home

# ── Domain & SSL (fill in after you point DNS to your server) ────────────────
# DOMAIN=retail.yourdomain.com
# SSL_EMAIL=admin@yourdomain.com

# ── API Settings ─────────────────────────────────────────────────────────────
# LOG_LEVEL=info
# API_WORKERS=2

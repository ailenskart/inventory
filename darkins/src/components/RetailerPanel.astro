---
// "Where to Buy" slide-over <dialog>. Opened by the header button; without JS
// the button is an anchor to the footer partner band.
import retailers from '../data/retailers.json';
---

<dialog
  id="retailer-panel"
  class="m-0 mr-0 ml-auto h-dvh max-h-dvh w-full max-w-md bg-(--color-cacao-900) p-0 text-(--color-cream) backdrop:bg-black/60 backdrop:backdrop-blur-sm"
  aria-labelledby="retailer-panel-title"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b hairline px-6 py-5">
      <h2 id="retailer-panel-title" class="font-display text-2xl font-medium">Where to buy</h2>
      <button type="button" class="btn btn-ghost px-3 py-2 text-sm" data-close-panel aria-label="Close panel">✕</button>
    </div>
    <p class="px-6 pt-5 text-sm text-(--color-cream-dim)">
      We don't sell here — we make. Our retail partners handle the rest.
    </p>
    <ul class="flex-1 space-y-1 overflow-y-auto p-4">
      {
        retailers.map((r) => (
          <li>
            {r.url ? (
              <a
                href={r.url}
                target="_blank"
                rel="noopener"
                data-retailer={r.id}
                class="flex items-center gap-4 rounded-xl p-3 transition-colors hover:bg-(--color-cacao-800)"
              >
                <img src={r.logo} alt="" width="48" height="48" loading="lazy" class="h-12 w-12 rounded-lg bg-white object-contain p-1" />
                <span class="flex-1">
                  <span class="block font-semibold">{r.name}</span>
                  <span class="block text-[13px] text-(--color-cream-faint)">{r.note}</span>
                </span>
                <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ) : (
              <div class="flex items-center gap-4 rounded-xl p-3 opacity-80">
                <img src={r.logo} alt="" width="48" height="48" loading="lazy" class="h-12 w-12 rounded-lg bg-white object-contain p-1" />
                <span class="flex-1">
                  <span class="block font-semibold">{r.name}</span>
                  <span class="block text-[13px] text-(--color-cream-faint)">{r.note}</span>
                </span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
    <p class="border-t hairline px-6 py-4 text-[13px] text-(--color-cream-faint)">
      Bulk, wholesale or custom gifting? <a href="/contact" class="underline underline-offset-2 hover:text-(--color-cream)">Talk to us directly</a>.
    </p>
  </div>
</dialog>

<script>
  const panel = document.getElementById('retailer-panel') as HTMLDialogElement | null;
  document.querySelectorAll<HTMLElement>('[data-open-panel]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      if (!panel) return;
      e.preventDefault();
      panel.showModal();
    });
  });
  panel?.querySelector('[data-close-panel]')?.addEventListener('click', () => panel.close());
  panel?.addEventListener('click', (e) => {
    if (e.target === panel) panel.close();
  });
</script>

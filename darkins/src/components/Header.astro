---
import { SITE } from '../lib/site';
const nav = [
  ['Products', '/products'],
  ['Process', '/process'],
  ['Story', '/story'],
  ['Experiences', '/experiences'],
  ['Journal', '/journal'],
  ['Contact', '/contact'],
] as const;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b hairline bg-(--color-cacao-950)/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="font-display text-2xl font-semibold tracking-tight" aria-label={`${SITE.name} — home`}>
      Darkins<span class="text-(--color-ember-bright)">.</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-6 lg:flex">
      {
        nav.map(([label, href]) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class={`text-sm font-medium transition-colors hover:text-(--color-cream) ${isActive(href) ? 'text-(--color-cream)' : 'text-(--color-cream-dim)'}`}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#where-to-buy" data-open-panel class="btn btn-primary hidden px-4 py-2.5 text-sm sm:inline-flex">Where to Buy</a>
      <button
        type="button"
        class="btn btn-ghost px-3 py-2.5 text-sm lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        Menu
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t hairline lg:hidden" data-menu>
    <div class="mx-auto max-w-7xl space-y-1 px-4 py-4 sm:px-6">
      {
        nav.map(([label, href]) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class="block rounded-lg px-3 py-2.5 font-display text-xl hover:bg-(--color-cacao-800)"
          >
            {label}
          </a>
        ))
      }
      <a href="/#where-to-buy" data-open-panel class="btn btn-primary mt-3 w-full sm:hidden">Where to Buy</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Close' : 'Menu';
  });
</script>

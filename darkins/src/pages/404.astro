---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Darkins Chocolates" description="This page has melted.">
  <section class="mx-auto flex max-w-7xl flex-col items-start px-4 py-28 sm:px-6 lg:py-40">
    <span class="pct text-[clamp(6rem,20vw,14rem)] leading-none text-(--color-ember-bright)">404</span>
    <h1 class="display-sm mt-6">This page has melted.</h1>
    <p class="prose-dark mt-4 max-w-md">
      Left out at room temperature too long, probably. Everything else is still perfectly
      tempered.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary px-7 py-4">Back home</a>
      <a href="/products" class="btn btn-ghost px-7 py-4">Browse the menu</a>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`Darkins Chocolate, ${SITE.address}`);
---

<Base
  title="Contact — Darkins Chocolates"
  description="Reach the Darkins studio in Okhla, New Delhi — orders, wholesale, collaborations and factory tour bookings. Call, WhatsApp or email."
>
  <header class="mx-auto max-w-7xl px-4 pt-20 pb-12 sm:px-6 lg:pt-28">
    <p class="kicker mb-4">Contact</p>
    <h1 class="display max-w-3xl">Talk to the makers.</h1>
  </header>

  <section class="mx-auto grid max-w-7xl gap-12 px-4 pb-24 sm:px-6 lg:grid-cols-2">
    <div class="space-y-8">
      <div>
        <h2 class="kicker mb-3">The studio</h2>
        <p class="font-display text-2xl font-medium">Darkins Chocolate Pvt. Ltd.</p>
        <address class="mt-2 text-(--color-cream-dim) not-italic">
          2nd Floor, B-108, Pocket B,<br />
          Okhla Phase I, New Delhi 110020
        </address>
        <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn-ghost mt-5">Open in Google Maps</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <h2 class="kicker mb-3">Call / WhatsApp</h2>
          <a href={`tel:${SITE.phone.replace(/ /g, '')}`} class="text-lg underline-offset-3 hover:underline">{SITE.phone}</a>
          <a href={SITE.whatsapp} target="_blank" rel="noopener" data-retailer="whatsapp" class="btn btn-primary mt-4 block w-fit">Message on WhatsApp</a>
        </div>
        <div>
          <h2 class="kicker mb-3">Email</h2>
          <a href={`mailto:${SITE.email}`} class="text-lg underline-offset-3 hover:underline">{SITE.email}</a>
          <p class="mt-2 text-sm text-(--color-cream-faint)">We reply within a working day or two.</p>
        </div>
      </div>

      <div id="wholesale" class="scroll-mt-24 rounded-2xl border hairline bg-(--color-cacao-900) p-7">
        <h2 class="font-display text-2xl font-medium">Wholesale, gifting & collabs</h2>
        <p class="prose-dark mt-3 text-sm">
          Corporate gifting, retail stocking, couvertures for your kitchen, or a collaboration
          bar with your brand on it — we do all of the above. Handmade to order, so allow three
          to four weeks for larger runs.
        </p>
        <a
          href={`mailto:${SITE.email}?subject=${encodeURIComponent('Wholesale / collaboration enquiry')}`}
          class="btn btn-primary mt-6"
        >
          Start a wholesale enquiry
        </a>
      </div>
    </div>

    <!-- location panel: static, no third-party embeds -->
    <div class="reveal">
      <a href={mapsUrl} target="_blank" rel="noopener" class="group block overflow-hidden rounded-2xl border hairline bg-(--color-cacao-900)" aria-label="Open the Darkins studio location in Google Maps">
        <div class="relative aspect-square sm:aspect-4/3">
          <svg viewBox="0 0 400 300" class="h-full w-full" aria-hidden="true">
            <rect width="400" height="300" fill="var(--color-cacao-900)" />
            <g stroke="var(--color-cacao-700)" stroke-width="1.5">
              <path d="M0 80 L400 60" /><path d="M0 150 L400 170" /><path d="M0 230 L400 240" />
              <path d="M90 0 L110 300" /><path d="M200 0 L190 300" /><path d="M310 0 L330 300" />
            </g>
            <g stroke="var(--color-cream-faint)" stroke-width="2">
              <path d="M0 150 L400 170" /><path d="M200 0 L190 300" />
            </g>
            <circle cx="196" cy="162" r="10" fill="var(--color-ember-bright)" class="transition-transform duration-300 group-hover:scale-125" style="transform-origin: 196px 162px" />
            <circle cx="196" cy="162" r="20" stroke="var(--color-ember-bright)" stroke-opacity="0.4" fill="none" />
            <text x="216" y="150" font-size="14" fill="var(--color-cream)" font-weight="600">Darkins Studio</text>
            <text x="216" y="168" font-size="11" fill="var(--color-cream-faint)">Okhla Phase I</text>
          </svg>
          <span class="absolute right-4 bottom-4 rounded-full bg-(--color-cacao-950)/80 px-4 py-2 text-xs font-semibold backdrop-blur group-hover:bg-(--color-ember)">
            Open map ↗
          </span>
        </div>
      </a>
      <p class="mt-3 text-xs text-(--color-cream-faint)">
        Stylized map — tap through for directions. Studio visits by appointment or on a
        <a href="/experiences" class="underline underline-offset-2">factory tour</a>.
      </p>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: SITE.name },
  ...(post.data.cover ? { image: new URL(post.data.cover, SITE.domain).href } : {}),
  mainEntityOfPage: `${SITE.domain}/journal/${post.id}`,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: `${SITE.domain}/journal` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: `${SITE.domain}/journal/${post.id}` },
  ],
};
---

<Base
  title={`${post.data.title} — Darkins Journal`}
  description={post.data.excerpt}
  ogImage={post.data.cover || undefined}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="mx-auto max-w-3xl px-4 pt-16 pb-24 sm:px-6 lg:pt-24">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-(--color-cream-faint)">
      <a href="/journal" class="hover:text-(--color-cream)">← Journal</a>
    </nav>
    <p class="kicker mb-4">{fmt(post.data.date)} · {post.data.author}</p>
    <h1 class="display-sm">{post.data.title}</h1>
    {
      post.data.cover && (
        <img src={post.data.cover} alt="" width="960" height="540" loading="eager" fetchpriority="high" class="img-frame mt-10 w-full rounded-2xl object-cover" />
      )
    }
    <div class="journal-body mt-10">
      <Content />
    </div>
  </article>
</Base>

<style is:global>
  /* Ported Shopify HTML — style the raw markup. */
  .journal-body { color: var(--color-cream-dim); font-size: 1.0625rem; line-height: 1.75; }
  .journal-body h1, .journal-body h2, .journal-body h3, .journal-body h4 {
    font-family: var(--font-display);
    color: var(--color-cream);
    font-weight: 540;
    line-height: 1.15;
    margin: 2.2em 0 0.6em;
    text-wrap: balance;
  }
  .journal-body h1 { font-size: 1.9rem; }
  .journal-body h2 { font-size: 1.6rem; }
  .journal-body h3 { font-size: 1.3rem; }
  .journal-body p { margin: 1em 0; }
  .journal-body strong, .journal-body b { color: var(--color-cream); }
  .journal-body a { color: var(--color-cream); text-decoration: underline; text-underline-offset: 3px; }
  .journal-body img { border-radius: 1rem; margin: 2em auto; max-width: 100%; height: auto; }
  .journal-body ul, .journal-body ol { padding-left: 1.4em; margin: 1em 0; }
  .journal-body ul { list-style: disc; }
  .journal-body ol { list-style: decimal; }
  .journal-body li { margin: 0.4em 0; }
  .journal-body blockquote {
    border-left: 3px solid var(--color-ember);
    padding-left: 1.2em;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-cream);
    margin: 1.6em 0;
  }
  .journal-body table { width: 100%; font-size: 0.9em; border-collapse: collapse; margin: 1.5em 0; display: block; overflow-x: auto; }
  .journal-body td, .journal-body th { border: 1px solid rgb(244 237 228 / 0.15); padding: 0.5em 0.8em; }
  .journal-body iframe { max-width: 100%; }
</style>
